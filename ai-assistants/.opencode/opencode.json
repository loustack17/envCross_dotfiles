{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "*": "deny",
        "bash": "ask",
        "edit": "ask",
        "glob": "allow",
        "grep": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "external_directory": "ask"
      }
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 10000
  },
  "provider": {
    "nvidia": {
      "options": {
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "bat *": "allow",
      "bun *": "ask",
      "eza *": "allow",
      "git diff*": "allow",
      "git status*": "allow",
      "pnpm *": "ask",
      "rg *": "allow",
      "uv *": "ask"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "plugin": [
    "opencode-antigravity-auth@latest",
    "@tarquinen/opencode-dcp@latest",
    "cc-safety-net",
    "@slkiser/opencode-quota",
    "oh-my-opencode-slim"
  ]
}
