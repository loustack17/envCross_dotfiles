{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "orchestrator": {
      "permission": {
        "*": "ask",
        "bash": "ask",
        "edit": "ask",
        "glob": "allow",
        "grep": "allow"
      }
    }
  },
  "compaction": {
    "prune": true
  },
  "lsp": {
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh",
        ".ksh",
        ".bashrc",
        ".zshrc"
      ]
    },
    "fish-lsp": {
      "command": [
        "fish-lsp",
        "start"
      ],
      "extensions": [
        ".fish"
      ]
    },
    "gopls": {
      "command": [
        "gopls"
      ]
    },
    "json-ls": {
      "command": [
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc",
        ".code-workspace"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ]
    },
    "terraform": {
      "disabled": true
    },
    "tofu-ls": {
      "command": [
        "tofu-ls",
        "serve"
      ],
      "extensions": [
        ".tf",
        ".tfvars",
        ".tf.json",
        ".tofu",
        ".tofu.json"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ]
    },
    "yaml-ls": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ]
    }
  },
  "mcp": {
    "code-review-graph": {
      "command": [
        "uvx",
        "code-review-graph",
        "serve"
      ],
      "enabled": true,
      "type": "local"
    },
    "crawl4ai": {
      "command": [
        "/home/lou/Documents/WorkFlow/envCross_dotfiles/scripts/mcp/run-crawl4ai.sh"
      ],
      "enabled": true,
      "type": "local"
    },
    "content-i18n": {
      "command": [
        "/home/lou/.local/bin/content-i18n",
        "mcp",
        "--config",
        "/home/lou/Documents/LouStackBase/content-i18n.yaml"
      ],
      "enabled": true,
      "type": "local"
    },
    "firecrawl": {
      "command": [
        "/home/lou/Documents/WorkFlow/envCross_dotfiles/scripts/mcp/run-firecrawl.sh"
      ],
      "enabled": true,
      "type": "local"
    },
    "markitdown": {
      "command": [
        "markitdown-mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "mem0": {
      "command": [
        "/home/lou/Documents/WorkFlow/envCross_dotfiles/scripts/mcp/run-mem0.sh"
      ],
      "enabled": true,
      "type": "local"
    },
    "tavily": {
      "command": [
        "/home/lou/Documents/WorkFlow/envCross_dotfiles/scripts/mcp/run-tavily.sh"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "lsp": "allow"
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-antigravity-auth@latest",
    "@tarquinen/opencode-dcp@latest",
    "cc-safety-net",
    "@slkiser/opencode-quota",
    "oh-my-opencode-slim"
  ]
}
