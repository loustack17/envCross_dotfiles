# Installer backups and local secrets
backup/
.env
.envrc
*.secret.toml

# Python and editor caches
__pycache__/
*.py[cod]
nvim.log
/.claude/
/nvim/.claude/
/.codex/

# AI tool runtime state written through linked directories
/ai-assistants/.codex/local/
ai-assistants/SKILLS/.system/
ai-assistants/SKILLS/synced/

# App-managed state that rewrites itself
zed/settings_backup.json
/lazygit/state.yml
/lazygit/github_pull_requests.json
nvim/lazy-lock.json
yazi/config/
yazi/plugins/custom-shell.yazi/yazi_cmd_history
yazi/plugins/whoosh.yazi/bookmarks
Windows/yasb/**/*.log
Windows/nushell/history.txt
/sqlit/*
!/sqlit/keymap.json
!/sqlit/README.md

# Backup copies left by Linux apps
Linux-config/**/*.bak
Linux-config/**/*.bak.*
Linux-config/**/*.backup
Linux-local-share/**/*.bak
Linux-local-share/**/*.backup
