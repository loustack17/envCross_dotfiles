[Unit]
Description=Update Crawl4AI container
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
ExecStart=%h/.local/share/envcross/scripts/secrets/run.sh -- /usr/bin/docker compose --file %h/.local/share/envcross/Linux-config/docker/crawl4ai/compose.yaml up --detach --remove-orphans --wait --wait-timeout 180
