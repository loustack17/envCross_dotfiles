[Desktop Entry]
Name=OpenWhispr
Comment=Voice-to-text dictation with local and cloud AI models (Vulkan GPU)
Exec=sh -c '"$HOME/.local/share/envcross/scripts/secrets/run-openwhispr.sh" "$@"' openwhispr %U
Icon=openwhispr
Type=Application
Categories=Utility;AudioVideo;
StartupWMClass=open-whispr
MimeType=x-scheme-handler/openwhispr;
