{
  "vim_mode": true,
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "theme": "Dracula Solid",
  "proxy": "",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "left",
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "qwen3.5:4b",
        "enable_thinking": true
      },
      {
        "provider": "openai",
        "model": "gpt-5.5",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
    "tool_permissions": {
      "default": "confirm"
    }
  },
  "git_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  }
}
